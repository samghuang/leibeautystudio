---
/**
 * Line icon set (24×24, stroke-based, inherits `currentColor`).
 *
 * Data files reference icons by name, so the SVG markup stays out of the
 * content layer. Icons are decorative by default and hidden from assistive
 * technology; pass a `label` when an icon is the only content of a control.
 */

interface Props {
  /**
   * Key into the set below. Typed as `string` because the data files are
   * plain JS and would widen a literal union anyway — the guard further down
   * is the real check, and since every page is rendered at build time an
   * unknown name fails `npm run build` rather than shipping a blank icon.
   */
  name: string;
  class?: string;
  /** Set when the icon is a control's only content; omit when decorative. */
  label?: string;
  [key: string]: unknown;
}

const paths = {
  scissors: `<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/>`,
  bottle: `<path d="M9 3h6v3l1.5 2.5a3 3 0 0 1 .5 1.7V19a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V10.2a3 3 0 0 1 .5-1.7L9 6V3z"/><line x1="9" y1="13" x2="15" y2="13"/>`,
  comb: `<path d="M3 14c0-4 3-8 9-8s9 4 9 8"/><line x1="6" y1="14" x2="6" y2="20"/><line x1="10" y1="14" x2="10" y2="21"/><line x1="14" y1="14" x2="14" y2="21"/><line x1="18" y1="14" x2="18" y2="20"/>`,
  face: `<ellipse cx="12" cy="12" rx="6.5" ry="8.5"/><circle cx="9.5" cy="11" r="0.6" fill="currentColor"/><circle cx="14.5" cy="11" r="0.6" fill="currentColor"/><path d="M10 15c.6.6 1.3 1 2 1s1.4-.4 2-1"/>`,
  eye: `<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.2"/><path d="M5 6l1 2M9 4l.5 2M15 4l-.5 2M19 6l-1 2"/>`,
  lipstick: `<path d="M9 3l4 5h-2v3h-1V8H8l1-5z"/><rect x="7.5" y="11" width="6" height="3"/><rect x="6.5" y="14" width="8" height="7" rx="1"/>`,
  body: `<circle cx="12" cy="5" r="2.2"/><path d="M12 8v6M9 10l-2 5M15 10l2 5M10 14v7M14 14v7"/>`,
  sparkle: `<path d="M12 3v6M12 15v6M3 12h6M15 12h6M5.6 5.6l4 4M14.4 14.4l4 4M18.4 5.6l-4 4M9.6 14.4l-4 4"/>`,
  drop: `<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>`,
  leaf: `<path d="M5 19c0-9 6-15 15-15-1 9-6 15-15 15z"/><path d="M5 19l8-8"/>`,
  brush: `<path d="M8 4h8l-1 9H9L8 4z"/><path d="M10 13v3a2 2 0 0 0 4 0v-3"/><line x1="12" y1="18" x2="12" y2="22"/>`,
  lash: `<path d="M3 14c2-3 5.5-4 9-4s7 1 9 4"/><path d="M5 12V8M9 11V6M12 10V5M15 11V6M19 12V8"/>`,
  arrow: `<line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/>`,
  phone: `<path d="M22 16.92V20a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3.08a2 2 0 0 1 2 1.72c.13.93.36 1.84.7 2.7a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.38-1.35a2 2 0 0 1 2.11-.45c.86.34 1.77.57 2.7.7a2 2 0 0 1 1.72 2.05z"/>`,
} as const;

const { name, label, ...attrs } = Astro.props;

const markup: string | undefined = (paths as Record<string, string>)[name];
if (!markup) {
  throw new Error(`<Icon name="${name}"> is not a known icon.`);
}
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...attrs}
  set:html={markup}
/>
